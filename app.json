{
  "expo": {
    "name": "FestNest",
    "slug": "festnest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "festnest",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0C16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.festnest.app",
      "associatedDomains": [
        "applinks:festnest.app",
        "applinks:www.festnest.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0C16"
      },
      "package": "com.festnest.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "festnest.app",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "www.festnest.app",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}

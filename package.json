{
  "name": "festnest",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.21.0 <23"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "workspace:check": "node scripts/check-workspace.mjs",
    "browser:preflight": "node scripts/check-browser-environment.mjs",
    "prebrowser:serve": "npm run workspace:check && npm run browser:preflight",
    "browser:serve": "node scripts/export-browser-app.mjs",
    "lint": "eslint . --ext .js,.jsx,.mjs,.ts,.tsx --cache",
    "pretest:browser": "npm run workspace:check && node scripts/check-browser-environment.mjs",
    "test:browser": "playwright test",
    "test:demo": "./scripts/demo/run-equipment-test.sh",
    "test:demo-proxy": "node --test tests/demo/stale-proxy.test.mjs",
    "pretest:demo-browser": "npm run workspace:check && node scripts/check-browser-environment.mjs",
    "test:demo-browser": "playwright test --config playwright.live-demo.config.ts",
    "test:demo-browser:repeat": "node scripts/demo/run-browser-workflow.mjs --runs 3",
    "test:browser-harness": "node --test tests/browserHarness.test.mjs",
    "test:live": "node scripts/live-authorization-matrix.mjs",
    "test": "tsc -p tsconfig.qa-tests.json && node --test /tmp/festnest-qa-tests/tests/*.test.js",
    "lint:fix": "npm run lint -- --fix"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.99.2",
    "expo": "~55.0.13",
    "expo-asset": "~55.0.14",
    "expo-constants": "~55.0.13",
    "expo-crypto": "~55.0.14",
    "expo-font": "~55.0.6",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.12",
    "expo-router": "~55.0.11",
    "expo-screen-orientation": "~55.0.13",
    "expo-secure-store": "~55.0.13",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "lucide-react-native": "^1.7.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-maps": "^1.27.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "1.61.0",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "babel-preset-expo": "~55.0.16",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^55.0.0",
    "supabase": "2.115.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
